{
  "dependencies": {
    "@preact/signals": "2.11.3",
    "preact": "11.0.2"
  },
  "description": "preact clock, inspired by sauron clock",
  "devDependencies": {
    "@e18e/eslint-plugin": "0.8.1",
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/css": "2.0.1",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@eslint/markdown": "8.0.3",
    "@html-eslint/eslint-plugin": "0.67.0",
    "@preact/eslint-plugin-signals": "0.3.0",
    "@preact/preset-vite": "2.10.6",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-yml": "3.9.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-checker": "0.14.5",
    "vitest": "5.0.5",
    "vitest-browser-preact": "1.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "download",
      "version": "12.15.0"
    },
    "runtime": {
      "name": "node",
      "onFail": "download",
      "version": "26.12.1"
    }
  },
  "imports": {
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx"
    ]
  },
  "keywords": [
    "preact",
    "clock",
    "svg"
  ],
  "license": "MIT",
  "name": "preact-clock",
  "repository": {
    "type": "git",
    "url": "https://github.com/high1/preact-clock"
  },
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "playwright": "playwright install --only-shell chromium",
    "preview": "vite preview",
    "start": "vite",
    "test": "vitest run"
  },
  "type": "module",
  "version": "1.0.0"
}
